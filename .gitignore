# Ключи нейросетей — никогда не попадают в git. Образец без ключей — .env.example
.env

# Библиотеки — ставятся сами при первом запуске run.py
core/.venv/
__pycache__/
*.pyc

# Ролики: сценарии, картинки, видео — создаются программой и много весят
projects/

# Недописанные файлы (при остановке через Ctrl+C)
*.part
